  background: #0f1115; border: 1px solid #262a33; border-radius: 3px;
  padding: 4px 6px; margin-top: 4px;
  font-size: 10px;
}
.chain .chain-node {
  background: #1a1d24; border: 1px solid #2d3138; padding: 1px 5px;
  border-radius: 3px; color: #aaa; font-family: 'JetBrains Mono', monospace;
  max-width: 110px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.chain .chain-node.target { background: #1a2330; border-color: #4a86c5; color: #79b8ff; font-weight: 600; }
.chain .chain-node.source { background: #2a1818; border-color: #6a3030; color: #ff8b95; }
.chain .chain-arrow { color: #555; font-size: 10px; }
.chain-label {
  font-size: 9px; color: #6e7681; letter-spacing: .04em;
  text-transform: uppercase; margin-right: 3px;
}

.unblock-list {
  margin-top: 5px; padding-top: 5px; border-top: 1px dashed #262a33;
  font-size: 10.5px; color: #888; line-height: 1.5;
}
.unblock-list .head {
  font-size: 9.5px; letter-spacing: .05em; text-transform: uppercase;
  color: #6e7681; font-weight: 600; margin-bottom: 2px;
}
.unblock-list .un-item {
  font-family: 'JetBrains Mono', monospace; color: #b8c1d1; font-size: 10px;
  margin-right: 4px; display: inline-block;
}
.unblock-list .un-item.more { color: #6e7681; }

/* ── DETAIL PANEL ───────────────────────────────────────────── */
#detail-panel {
  position: fixed; top: 0; right: -480px; width: 480px; height: 100%;
  background: #131620; border-left: 1px solid #262a33;
  box-shadow: -8px 0 20px rgba(0,0,0,0.4);
  transition: right 0.22s ease-out;
  display: flex; flex-direction: column; z-index: 50;
  overflow: hidden;
}
#detail-panel.open { right: 0; }
#detail-head {
  padding: 14px 16px 10px; border-bottom: 1px solid #262a33;
  position: relative;
}
#detail-head .name {
  font-family: 'JetBrains Mono', monospace; font-size: 14px; font-weight: 700; color: #e6e9ef;
  margin-bottom: 4px; word-break: break-all; padding-right: 60px;
}
#detail-head .module-path { font-size: 11px; color: #79b8ff; margin-bottom: 6px; word-break: break-all; }
#detail-head .meta-row {
  display: flex; gap: 14px; margin-top: 8px; font-size: 11px; color: #888;
  flex-wrap: wrap;
}
#detail-head .meta-row b { color: #d4d4d4; font-weight: 600; }
#detail-body {
  flex: 1; overflow-y: auto; padding: 12px 16px;
}
#detail-body::-webkit-scrollbar { width: 6px; }
#detail-body::-webkit-scrollbar-thumb { background: #2d3138; border-radius: 3px; }
.section { margin-bottom: 14px; }
.section h3 {
  font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase;
  color: #6e7681; font-weight: 600; margin-bottom: 6px;
}
.section .code-block {
  background: #0f1115; border: 1px solid #262a33; border-radius: 4px;
  padding: 8px 10px; font-family: 'JetBrains Mono', monospace; font-size: 11.5px;
  color: #ce9178; white-space: pre-wrap; overflow-x: auto;
}
.section .dep-chain-detail {
  display: flex; flex-direction: column; gap: 4px;
}
.section .dep-chain-detail .step {
  display: flex; align-items: center; gap: 6px;
  background: #181b25; border: 1px solid #262a33; padding: 5px 8px; border-radius: 4px;
  font-size: 11px;
}
.section .dep-chain-detail .step-idx {
  font-size: 9px; background: #2d3138; color: #aaa; width: 18px; height: 18px;
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; font-weight: 700;
}
.section .dep-chain-detail .step-name {
  font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #e6e9ef;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.section .dep-chain-detail .step-state {
  margin-left: auto; font-size: 9px; padding: 1px 5px; border-radius: 3px; font-weight: 700;
}
.section .blocks-grid {
  display: grid; grid-template-columns: 1fr; gap: 4px;
}
.section .blocks-grid .blk {
  background: #181b25; border-left: 2px solid #4a86c5; padding: 4px 8px;
  font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #b8c1d1;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
#close-detail {
