<style>
:root {
  --c-defined:   __COLOR_DEFINED__;
  --c-postulate: __COLOR_POSTULATE__;
  --c-hole:      __COLOR_HOLE__;
  --c-failed:    __COLOR_FAILED__;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  height: 100%; font-family: 'Inter', 'Segoe UI', system-ui, sans-serif; font-size: 13px;
  background: #0f1115; color: #d4d4d4; overflow: hidden;
}
body { display: flex; flex-direction: column; }

/* ── BANNER ──────────────────────────────────────────────────── */
#banner {
  background: linear-gradient(90deg, #1a1d24 0%, #131620 100%);
  border-bottom: 1px solid #262a33;
  padding: 8px 14px; display: flex; align-items: center; gap: 12px; flex-shrink: 0;
}
#banner .title { font-weight: 700; color: #fff; letter-spacing: .02em; font-size: 13px; }
#banner .subtitle { color: #888; font-size: 11.5px; }
#banner .goal-pill {
  margin-left: auto;
  background: #1a2330; border: 1px solid #2d4a6b;
  padding: 3px 10px; border-radius: 12px; font-size: 11px; color: #79b8ff;
  display: flex; align-items: center; gap: 6px;
  max-width: 60%;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
#banner .goal-pill .dot { width: 6px; height: 6px; border-radius: 50%; background: #79b8ff; flex-shrink: 0; }
#banner .goal-pill b { color: #cde2ff; font-family: 'JetBrains Mono', monospace; }

/* ── TOP STRIP ──────────────────────────────────────────────── */
#topstrip {
  background: #131620; border-bottom: 1px solid #262a33;
  padding: 10px 14px;
  display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr 1fr; gap: 10px;
  flex-shrink: 0;
}
.stat-card {
  background: #181b25; border: 1px solid #262a33; border-radius: 6px;
  padding: 8px 10px; display: flex; flex-direction: column; justify-content: space-between;
  min-height: 64px;
}
.stat-card .label {
  font-size: 10px; letter-spacing: .08em; text-transform: uppercase;
  color: #6e7681; font-weight: 600;
}
.stat-card .value {
  font-size: 22px; font-weight: 700; color: #e6e9ef; margin-top: 2px;
  display: flex; align-items: baseline; gap: 6px;
}
.stat-card .delta { font-size: 11px; font-weight: 600; }
.delta-down { color: #4caf50; }
.delta-up { color: #f06070; }
.delta-flat { color: #888; }
.stat-card .footnote { font-size: 10px; color: #6e7681; margin-top: 1px; }

#burndown-wrap {
  background: #181b25; border: 1px solid #262a33; border-radius: 6px;
  padding: 8px 10px; display: flex; flex-direction: column;
  grid-column: 1 / 2; min-height: 64px;
}
#burndown-header {
  display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 4px;
}
#burndown-header .label {
  font-size: 10px; letter-spacing: .08em; text-transform: uppercase;
  color: #6e7681; font-weight: 600;
}
#burndown-header .legend {
  font-size: 10px; color: #6e7681; display: flex; gap: 10px;
}
#burndown-header .legend span { display: flex; align-items: center; gap: 4px; }
#burndown-header .legend .swatch { width: 8px; height: 2px; }
#burndown-svg { flex: 1; width: 100%; }
#burndown-note {
  font-size: 10px; color: #6e7681; font-style: italic; padding: 6px 4px 0;
}

/* ── FILTER BAR ─────────────────────────────────────────────── */
#filterbar {
  background: #131620; border-bottom: 1px solid #262a33;
  padding: 6px 14px;
  display: flex; align-items: center; gap: 8px; flex-shrink: 0; flex-wrap: wrap;
}
.filter-group { display: flex; align-items: center; gap: 6px; }
.filter-group .label {
  font-size: 10.5px; color: #6e7681; letter-spacing: .04em;
  text-transform: uppercase; font-weight: 600;
}
#search-box, #module-filter, #affects-filter {
  background: #0f1115; border: 1px solid #2d3138; border-radius: 4px;
  color: #d4d4d4; padding: 4px 8px; font-size: 12px; outline: none;
  font-family: inherit; min-width: 140px;
}
#search-box:focus, #module-filter:focus, #affects-filter:focus { border-color: #4a86c5; }
.sev-pill {
  background: #1a1d24; border: 1px solid #2d3138; border-radius: 12px;
  padding: 3px 9px; font-size: 11px; color: #aaa; cursor: pointer;
  user-select: none; transition: all 0.12s;
}
.sev-pill:hover { border-color: #4a86c5; color: #fff; }
.sev-pill.active { background: #1a2330; border-color: #4a86c5; color: #79b8ff; }
.sev-pill .count { color: #6e7681; margin-left: 4px; font-size: 10.5px; }
.sev-pill.active .count { color: #4a86c5; }
.spacer { flex: 1; }
#affects-mode {
  display: flex; align-items: center; gap: 6px;
  background: #1a2330; border: 1px solid #2d4a6b; border-radius: 4px;
  padding: 4px 8px; font-size: 11px; color: #79b8ff; cursor: default;
}
#affects-mode.off { background: transparent; border-color: #2d3138; color: #888; }

/* ── BOARD ──────────────────────────────────────────────────── */
#board {
  flex: 1; display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 10px; padding: 10px 14px; overflow: hidden;
}
.lane {
  background: #131620; border: 1px solid #262a33; border-radius: 8px;
  display: flex; flex-direction: column; overflow: hidden; min-height: 0;
}
.lane-header {
  padding: 10px 12px 8px; border-bottom: 1px solid #262a33; flex-shrink: 0;
  display: flex; align-items: center; gap: 8px;
}
.lane-header .lane-icon {
  width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0;
}
.lane-header .lane-title {
  font-size: 12.5px; font-weight: 700; letter-spacing: .01em; flex: 1;
}
.lane-header .lane-count {
  background: #1a1d24; border: 1px solid #2d3138; padding: 1px 8px;
  border-radius: 10px; font-size: 11px; color: #aaa; font-weight: 600;
}
.lane-subtitle {
  padding: 0 12px 8px; font-size: 10.5px; color: #6e7681;
  border-bottom: 1px solid #262a33; flex-shrink: 0;
}

.lane-body {
  flex: 1; overflow-y: auto; padding: 8px;
  display: flex; flex-direction: column; gap: 6px; min-height: 0;
}
.lane-body::-webkit-scrollbar { width: 6px; }
.lane-body::-webkit-scrollbar-track { background: transparent; }
.lane-body::-webkit-scrollbar-thumb { background: #2d3138; border-radius: 3px; }

.lane.blocking   .lane-icon  { background: #f06070; box-shadow: 0 0 8px #f0607080; }
.lane.indirect   .lane-icon  { background: #f9a825; box-shadow: 0 0 6px #f9a82580; }
.lane.postulates .lane-icon  { background: #b977d8; }
.lane.done       .lane-icon  { background: #4caf50; }
.lane.blocking   .lane-title { color: #ff8b95; }
.lane.indirect   .lane-title { color: #ffcb6b; }
.lane.postulates .lane-title { color: #d6a8ee; }
.lane.done       .lane-title { color: #82d695; }

/* ── CARDS ──────────────────────────────────────────────────── */
.card {
  background: #181b25; border: 1px solid #262a33; border-left: 3px solid transparent;
  border-radius: 5px; padding: 9px 10px;
  cursor: pointer; transition: all 0.12s;
  position: relative;
}
.card:hover { background: #1d212c; border-color: #4a86c5; }
.card.dimmed { opacity: 0.22; }
.card.affects-highlight { border-color: #79b8ff; background: #1a2330; }
.card .card-top {
  display: flex; align-items: center; gap: 6px; margin-bottom: 4px;
}
.card .kind-badge {
  font-size: 9px; font-weight: 700; padding: 1px 5px; border-radius: 3px;
  letter-spacing: .04em; text-transform: uppercase; flex-shrink: 0;
}
.kind-hole      { background: #2e1b4d; color: #ce93d8; border: 1px solid #6a3aa0; }
.kind-postulate { background: #4d1b1b; color: #ef9a9a; border: 1px solid #a04040; }
.kind-done      { background: #1b4d1c; color: #a5d6a7; border: 1px solid #408040; }
.card .card-name {
  font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', 'Consolas', monospace;
  font-size: 12px; font-weight: 600; color: #e6e9ef;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1;
}
.card .card-module {
  font-size: 10.5px; color: #79b8ff; margin-bottom: 5px;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.card .card-meta {
  display: flex; align-items: center; gap: 8px; font-size: 10.5px;
  color: #888; margin-bottom: 6px;
}
.card .meta-item { display: flex; align-items: center; gap: 3px; }
.card .meta-item .meta-icon { font-size: 10px; color: #6e7681; }
.card .meta-item.severe { color: #ff8b95; font-weight: 600; }
.card .meta-item.medium { color: #ffcb6b; }

.card .file-line {
  font-family: 'JetBrains Mono', 'Fira Code', monospace;
  font-size: 10px; color: #6e7681;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.card.sev-high { border-left-color: #f06070; }
.card.sev-med  { border-left-color: #f9a825; }
.card.sev-low  { border-left-color: #4a86c5; }
