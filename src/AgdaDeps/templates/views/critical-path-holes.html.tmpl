<!DOCTYPE html>
<html lang="en">
<head>
<!-- agda-deps · critical-path-holes view: kanban board of holes / postulates / failed defs ranked by how much depends on them. -->
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>agda-deps — Critical-Path Holes</title>
<script>window.__gzipEnabled = __GZIP_ENABLED__;</script>
<script>
  if (window.__gzipEnabled && typeof DecompressionStream === 'undefined') {
    document.write('<scr'+'ipt src="https://unpkg.com/pako@2.1.0/dist/pako_inflate.min.js"></scr'+'ipt>');
  }
