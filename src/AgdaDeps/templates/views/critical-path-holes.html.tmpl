  justify-content: center; background: #0f1115; z-index: 100;
  font-size: 14px; color: #888;
}
#err { display: none; padding: 24px; text-align: center; }
#err.visible { display: flex; }
#err pre {
  background: #181b25; border: 1px solid #262a33;
  border-radius: 6px; padding: 12px; font-family: 'JetBrains Mono', monospace;
  font-size: 12px; color: #f06070; max-width: 600px;
  white-space: pre-wrap; text-align: left;
}
</style>
</head>
