cabal-version:       3.0
name:                agda-deps
version:             1.1
author:              Orestis Melkonian, Carlos Tomé Cortiñas, and Martín Ceresa
maintainer:          Orestis Melkonian, Carlos Tomé Cortiñas, and Martín Ceresa
category:            Language, Compiler
build-type:          Simple
synopsis:            Reporting lemma dependencies of Agda proofs.
description:
  An Agda compiler backend that emits definition- and module-level dependency
  graphs as DOT or versioned JSON for rendering and graph analysis.
license:             MIT
license-file:        LICENSE
homepage:            https://github.com/input-output-hk/agda-dependencies
bug-reports:         https://github.com/input-output-hk/agda-dependencies/issues

extra-doc-files:     README.md
                     Examples.md
                     Changelog.md
                     TODO.md
                     Backlog.md

source-repository head
  type:     git
  location: https://github.com/input-output-hk/agda-dependencies.git

-- agda-deps is the Agda compiler backend that emits graph.json.
executable agda-deps
  -- -with-rtsopts=-F1.2 caps old-gen heap growth at 1.2x live data (GHC
  -- default is 2.0x) to trim peak residency on large corpora (~11% measured);
  -- -rtsopts lets callers override at runtime via +RTS -F.
  ghc-options: -O2 -threaded -rtsopts -with-rtsopts=-F1.2
  default-language:    Haskell2010
  hs-source-dirs:      src
  main-is:             Main.hs
  other-modules:       Paths_agda_deps
                       BuildInfo
                       BuildInfoTH
                       AgdaDeps.Util
                       AgdaDeps.Arguments
                       AgdaDeps.AtomicWrite
                       AgdaDeps.Logging
                       AgdaDeps.Csr
                       AgdaDeps.Config
                       AgdaDeps.Layout
                       AgdaDeps.Options
                       AgdaDeps.MatchConstant
                       AgdaDeps.NodeKey
                       AgdaDeps.Deps
                       AgdaDeps.FragmentCache
                       AgdaDeps.SerialiseCache
                       AgdaDeps.Backend.Dot
                       AgdaDeps.Backend.Wire
                       AgdaDeps.Backend.GraphJson
                       AgdaDeps.Backend
                       AgdaDeps.Doctor
                       AgdaDeps.Help
                       AgdaDeps.ModuleExplorer
                       AgdaDeps.Driver
                       AgdaDeps.LibResolve
                       AgdaDeps.Precompute
                       AgdaDeps.SkipAgda
                       AgdaDeps.TermCanon
                       AgdaDeps.TypeExport
  autogen-modules:     Paths_agda_deps
  build-depends:       base >= 4.10 && < 4.23,
                       Agda >= 2.8 && < 3,
                       aeson >= 2.0 && < 3,
                       deepseq >= 1.4.4 && < 1.6,
                       text >= 1.2 && < 2.2,
                       containers >= 0.5 && < 0.8,
                       unordered-containers >= 0.2 && < 0.3,
                       filepath >= 1.4 && < 1.6,
                       graphviz >= 2999.20 && < 3000,
                       fgl >= 5.5 && < 5.9,
                       directory >= 1.3 && < 1.4,
                       mtl >= 2.2 && < 2.4,
                       bytestring >= 0.10 && < 0.13,
                       binary >= 0.8 && < 0.9,
                       process >= 1.6 && < 2,
                       template-haskell >= 2.12 && < 2.25,
                       yaml >= 0.11 && < 0.12,
                       zlib >= 0.6 && < 0.8,
  if !os(windows)
    build-depends:     unix >= 2.7 && < 2.9

test-suite hardening
  type:                exitcode-stdio-1.0
  hs-source-dirs:      test-hardening
                       src
  main-is:             Main.hs
  default-language:    Haskell2010
  ghc-options:         -Wall -Wcompat -Wincomplete-record-updates
                       -Wincomplete-uni-patterns -Wredundant-constraints
  other-modules:       AgdaDeps.AtomicWrite
                       AgdaDeps.Arguments
                       AgdaDeps.Logging
                       AgdaDeps.Layout
                       AgdaDeps.Precompute
                       AgdaDeps.Util
                       AgdaDeps.Options
                       AgdaDeps.NodeKey
                       AgdaDeps.TermCanon
                       AgdaDeps.TypeExport
                       AgdaDeps.MatchConstant
                       AgdaDeps.Deps
                       AgdaDeps.Backend.Wire
  build-depends:       base >= 4.10 && < 4.23,
                       aeson >= 2.0 && < 3,
                       Agda >= 2.8 && < 3,
                       deepseq >= 1.4.4 && < 1.6,
                       text >= 1.2 && < 2.2,
                       containers >= 0.5 && < 0.8,
                       unordered-containers >= 0.2 && < 0.3,
                       filepath >= 1.4 && < 1.6,
                       directory >= 1.3 && < 1.4,
                       mtl >= 2.2 && < 2.4,
                       bytestring >= 0.10 && < 0.13,
                       binary >= 0.8 && < 0.9,
                       process >= 1.6 && < 2
  if !os(windows)
    build-depends:     unix >= 2.7 && < 2.9
